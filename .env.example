# Copie este arquivo para ".env" (mesma pasta) e preencha. O ".env" NUNCA deve ser enviado/compartilhado.

# ───── Servidor SQL Server (somente leitura) ─────
DEV_DB_HOST=192.168.0.54
DEV_DB_PORT=1433
DEV_DB_USER=pwbi.desenvolvimento
DEV_DB_PASSWORD=
# Deixe em branco para o sistema descobrir sozinho o banco/esquema (rode:  python data_pipeline.py probe)
DEV_DB_NAME=
DEV_DB_SCHEMA=
# vazio = pymssql e, se faltar, pyodbc com {SQL Server}. Pode forçar: pymssql | pyodbc
DEV_DB_DRIVER=
# Se o erro falar em SSL/TLS ou versão do protocolo, tente 7.4 (ou 7.3)
DEV_DB_TDS=
DEV_DB_TIMEOUT=15
DEV_DB_OBJECT_DEV=DESENVOLVIMENTO_PRODUTOS
# Se o reconhecimento automático errar alguma coluna (JSON). Ex.: {"status": "STATUS_ITEM", "kind": "TIPO"}
DEV_DB_COLUMNS=

# ───── Sincronização ─────
# DIÁRIA e automática, uma vez por dia neste horário (se o app abrir depois dele, sincroniza ~20 s após abrir). Vazio = a cada DEV_SYNC_HOURS horas.
DEV_SYNC_AT=06:30
# 0 = desliga a automática (só o botão no topo da tela)
DEV_SYNC_HOURS=24
# amortecedor (padrão) = o servidor já filtra e só envia o que o app usa (DES/R-D, compras, embarques, estoque e garantia de amortecedor;
# vendas somadas por mês × SKU e só os meses que ainda mudam). tudo = traz as views inteiras (lento, comportamento antigo)
DEV_SYNC_ESCOPO=amortecedor
# anos de vendas na 1ª carga (depois é incremental: só o mês anterior em diante)
DEV_VENDAS_ANOS=3
# coluna de valor de VENDAS_FATURAMENTO_DETALHADO usada como «faturado» (o líquido VALOR_TOTAL_NET é guardado junto)
DEV_VENDAS_VALOR=VALOR_TOTAL_CIPI
# vazio = todos; ou limite os datasets: compras,vendas,embarques,estoque,garantia
DEV_SYNC_DATASETS=
# Trava de segurança: recusa carga com menos de 50% dos itens da sincronização anterior
DEV_SYNC_MIN_RATIO=0.5
# 1 = na 1ª carga cria eventos retroativos pela coluna de data "PEDIDO CONFIRMADO" (padrão 0 = marco zero puro)
DEV_SYNC_BACKFILL_DATES=0

# ───── Pesquisa de preços (Compra de amostras) ─────
# API oficial do Mercado Livre: crie o app em https://developers.mercadolivre.com.br e preencha ID e segredo (ou um token pronto).
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_ACCESS_TOKEN=
ML_SITE=MLB

# ───── Segurança ─────
# Primeiro acesso: o sistema pede para criar o administrador. (PSD_AUTH=off desliga o login — só para desenvolvimento.)
PSD_AUTH=on

# ── regras de negócio (também editáveis em Configurações > Administração > Regras de negócio) ──
ONLY_DESCRIPTION=AMORTECEDOR     # só itens cuja descrição contém este texto (vazio = todos)
GOAL_VALID_USER=ITALOC           # usuário cuja validação (USER APROV / USER_VALID) conta para a meta de REDESENVOLVIMENTO
